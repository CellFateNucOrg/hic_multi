/*
 * =========================================================================================
 *  hicpro-multicontact-nf Nextflow Configuration
 * =========================================================================================
 */

params {
    // Input / Output
    input                    = null
    outdir                   = './results'
    publish_dir_mode         = 'copy'

    // Reference genome (C. elegans WBcel235 / ce11)
    fasta                    = null
    bowtie2_index            = null
    restriction_bed          = null
    chrom_sizes              = null
    save_reference           = false

    // Arima Hi-C+ Restriction & Ligation Junction Settings
    // DpnII (^GATC) + HinfI (G^ANTC)
    restriction_sites        = '^GATC,G^ANTC'
    ligation_motifs          = 'arima'

    // Parallel FASTQ Chunking (reads per SLURM task chunk; 0 = disable chunking)
    fastq_chunk_size         = 2500000

    // Iterative Bowtie2 Mapping Parameters (HiC-Pro Q30 + 5' & 3' multi-round rescue)
    min_mapq                 = 30
    min_frag_len             = 20
    max_rounds               = 4
    trim_5p                  = 0
    seed_len_full            = 30
    seed_len_cut             = 20
    score_min                = 'L,-0.6,-0.2'
    save_intermediate_bams   = false

    // Multi-Contact Pairing & HiC-Pro Filtering Parameters
    dedup_overlapping_mates  = true
    discard_religation       = false
    keep_duplicates          = false
    save_dumped_pairs        = false

    // Cooler (.cool / .mcool) Resolutions tuned for C. elegans (~100 Mb genome)
    skip_cooler              = false
    cool_base_bin            = 500
    cool_resolutions         = '500,1000,2000,5000,10000,25000,50000,100000'
    balance_cooler           = true

    // SLURM / izblisbon.izb.unibe.ch cluster settings (partition = 'all')
    slurm_partition          = 'all'
    slurm_account            = null
    slurm_qos                = null
    slurm_cluster_options    = '--ntasks-per-core=2 --hint=multithread'
    slurm_queue_size         = 10
    conda_env                = '/home/pmeister/miniconda3/envs/HiC-Pro_v3.1.0'
    max_cpus                 = 16
    max_memory               = '64.GB'
    max_time                 = '24.h'
}

// Load base resource configuration
includeConfig 'conf/base.config'

profiles {
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
        apptainer.enabled      = false
        process.conda          = { params.conda_env ?: "${projectDir}/environment.yml" }
    }
    mamba {
        conda.enabled          = true
        conda.useMamba         = true
        docker.enabled         = false
        singularity.enabled    = false
        apptainer.enabled      = false
        process.conda          = "${projectDir}/environment.yml"
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        conda.enabled          = false
        docker.enabled         = false
        singularity.enabled    = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        apptainer.enabled      = false
    }
    slurm {
        process.executor       = 'slurm'
    }
    izblisbon {
        includeConfig 'conf/izblisbon.config'
    }
}

// Capture exit codes from upstream piped commands
process.shell = ['/bin/bash', '-euo', 'pipefail']

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.svg"
    overwrite = true
}

// Function to ensure resource requests do not exceed cluster maximums
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            return obj
        }
    }
}
