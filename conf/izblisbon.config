/*
 * =========================================================================================
 *  SLURM Configuration Profile for izblisbon.izb.unibe.ch
 * =========================================================================================
 *  Enforces SLURM Cluster Resource & CPU Throttling Rules:
 *    1. Dispatches all compute jobs to SLURM compute nodes via `--partition=all` (never on login node).
 *    2. Requests hyperthreaded logical CPUs (`--ntasks-per-core=2 --hint=multithread`).
 *    3. Prevents nested OpenMP/BLAS thread oversubscription (`OMP_NUM_THREADS=1`, etc.).
 *    4. Caps concurrent SLURM tasks via `params.slurm_queue_size` and `params.max_cpus`
 *       computed from <= 50% of currently available cluster CPUs.
 */

executor {
    name              = 'slurm'
    queueSize         = params.slurm_queue_size
    submitRateLimit   = '10/1min'
    pollInterval      = '15 sec'
    queueStatInterval = '1 min'
}

process {
    executor       = 'slurm'
    queue          = { params.slurm_partition ?: 'all' }
    clusterOptions = {
        def opts = []
        if (params.slurm_account)         opts << "--account=${params.slurm_account}"
        if (params.slurm_qos)             opts << "--qos=${params.slurm_qos}"
        if (params.slurm_cluster_options) opts << "${params.slurm_cluster_options}"
        return opts.join(' ')
    }

    beforeScript   = 'export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1'

    // Use node-local scratch ($TMPDIR or /tmp) during iterative Bowtie2 rounds to reduce NFS I/O
    scratch = true

    withName: 'DIGEST_GENOME' {
        cpus   = 2
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        time   = { check_max( 30.m * task.attempt, 'time'   ) }
    }

    withName: 'BOWTIE2_BUILD' {
        cpus   = { check_max( 8    * task.attempt, 'cpus'   ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 1.h  * task.attempt, 'time'   ) }
    }

    withName: 'ITERATIVE_BOWTIE2_MAP' {
        cpus   = { check_max( 8     * task.attempt, 'cpus'   ) }
        memory = { check_max( 12.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h   * task.attempt, 'time'   ) }
    }

    withName: 'PAIR_MULTICONTACTS' {
        cpus   = { check_max( 4     * task.attempt, 'cpus'   ) }
        memory = { check_max( 12.GB * task.attempt, 'memory' ) }
        time   = { check_max( 3.h   * task.attempt, 'time'   ) }
    }

    withName: 'MERGE_DEDUP_PAIRS' {
        cpus   = { check_max( 8     * task.attempt, 'cpus'   ) }
        memory = { check_max( 24.GB * task.attempt, 'memory' ) }
        time   = { check_max( 6.h   * task.attempt, 'time'   ) }
    }

    withName: 'BUILD_COOLER' {
        cpus   = { check_max( 8     * task.attempt, 'cpus'   ) }
        memory = { check_max( 24.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h   * task.attempt, 'time'   ) }
    }
}
